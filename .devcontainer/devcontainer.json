{
  "name": "NetGuardian Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install uv==0.13.7 && uv sync --locked",
  "postAttachCommand": "uv run --locked streamlit run app.py --server.address 127.0.0.1",
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "NetGuardian", "onAutoForward": "notify"}}
}
